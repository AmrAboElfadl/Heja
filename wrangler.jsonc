// Cloudflare Workers settings for the Heja store.
// Secrets and variables (OPENROUTER_API_KEY, SUPABASE_URL, SUPABASE_ANON_KEY) are set in the
// Cloudflare dashboard, not here; "keep_vars" stops a deploy from removing them.
{
  "name": "heja",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "build": { "command": "sh build.sh" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
